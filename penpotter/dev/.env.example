# Penpotter dev stack (local Mac). Copy to .env and fill in.
#   cp .env.example .env && python3 -c "import secrets;print('PENPOT_SECRET_KEY='+secrets.token_urlsafe(64))" >> .env

# --- which images to run -----------------------------------------------------
# Upstream stable (fastest way to get running; multi-arch, works on Apple silicon):
IMAGE_PREFIX=penpotapp/
PENPOT_VERSION=2.17
# Our own build from the `penpotter` branch (after CI has pushed them):
# IMAGE_PREFIX=ghcr.io/amannigam/penpotter-
# PENPOT_VERSION=dev

# --- local ports (offset from prod so both can coexist) ----------------------
PENPOT_HTTP_PORT=9101
PENPOT_MAILCATCH_PORT=9180
PENPOT_PUBLIC_URI=http://localhost:9101

# --- secrets -----------------------------------------------------------------
# 512-bit base64 master key. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PENPOT_SECRET_KEY=
