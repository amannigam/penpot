{
  "name": "penpotter-desktop",
  "productName": "Penpotter",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for our self-hosted Penpot instance",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "start:dev": "PENPOTTER_INSTANCE=dev electron .",
    "dist": "electron-builder --mac --publish never",
    "dist:universal": "electron-builder --mac --universal --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.saarstudios.penpotter",
    "productName": "Penpotter",
    "files": ["src/**/*", "package.json"],
    "directories": { "output": "dist", "buildResources": "build" },
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [{ "target": "dmg", "arch": ["arm64"] }],
      "darkModeSupport": true
    }
  }
}
