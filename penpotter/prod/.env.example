# Penpotter production (home lab). Copy to .env on the server and fill in.
# NEVER commit the real .env — it is gitignored.

# --- images ------------------------------------------------------------------
# Until our own CI images exist, run upstream stable. Our `penpotter` branch is
# based on upstream main (the 2.17 line), so switching the prefix later is an
# ordinary forward upgrade on the same database.
IMAGE_PREFIX=penpotapp/
PENPOT_VERSION=2.17
# Ours, once CI is green. Pin to an immutable vX.Y.Z tag rather than `release`
# so a rollback is a one-line edit.
# IMAGE_PREFIX=ghcr.io/amannigam/penpotter-
# PENPOT_VERSION=release

# --- exposure ----------------------------------------------------------------
# The URL users type. MUST match how they reach it, or assets/websockets break.
# On the home lab this is served by `tailscale serve` on port 8443, because
# port 443 on lab.tail101716.ts.net is already proxying another service.
PENPOT_PUBLIC_URI=https://lab.tail101716.ts.net:8443
PENPOT_HTTP_PORT=9001
# 127.0.0.1 = reverse proxy / tailscale serve only. 0.0.0.0 = reachable on LAN.
PENPOT_BIND=127.0.0.1
# Only used with the `caddy` profile.
PENPOT_DOMAIN=design.example.com

# --- feature flags -----------------------------------------------------------
# Internal instance: registration closed (invite-only), email verification on,
# real SMTP, secure cookies ON (do NOT add disable-secure-session-cookies when
# serving over HTTPS), telemetry off.
PENPOT_FLAGS=disable-registration enable-smtp enable-log-invitation-tokens enable-mcp enable-webhooks enable-access-tokens enable-auto-file-snapshot disable-telemetry
# If you must serve over plain HTTP on the LAN, append: disable-secure-session-cookies
# (logins will not work over HTTP with secure cookies enabled.)

# --- social login ------------------------------------------------------------
# Target flag set once Google/GitHub OAuth apps exist. Read it as:
#   disable-registration        no self-serve email+password signup
#   enable-oidc-registration    ...but signing in with a provider DOES create
#                               the account (only takes effect when general
#                               registration is disabled)
#   disable-login-with-password hides the email/password form entirely
# PENPOT_FLAGS=disable-registration enable-oidc-registration disable-login-with-password enable-login-with-google enable-login-with-github enable-smtp enable-log-invitation-tokens enable-mcp enable-webhooks enable-access-tokens enable-auto-file-snapshot disable-telemetry
#
# Redirect URI to register with BOTH providers (they share one callback):
#   https://lab.tail101716.ts.net:8443/api/auth/oidc/callback
PENPOT_GOOGLE_CLIENT_ID=
PENPOT_GOOGLE_CLIENT_SECRET=
PENPOT_GITHUB_CLIENT_ID=
PENPOT_GITHUB_CLIENT_SECRET=
# Comma-separated. Restricts who may create an account, however they sign in.
PENPOT_REGISTRATION_DOMAIN_WHITELIST=

# --- secrets -----------------------------------------------------------------
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PENPOT_SECRET_KEY=
# openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_USER=penpot
POSTGRES_DB=penpot

# --- email -------------------------------------------------------------------
# Default: self-hosted Mailpit sink on this box (free, no provider account).
# It ACCEPTS mail and shows it in a web UI; it does NOT deliver to the internet.
# Invitations therefore work by opening Mailpit, copying the invite link, and
# passing it to the person over chat.
COMPOSE_PROFILES=mailpit
MAILPIT_UI_PORT=8025
PENPOT_SMTP_HOST=penpot-mailpit
PENPOT_SMTP_PORT=1025
PENPOT_SMTP_USERNAME=
PENPOT_SMTP_PASSWORD=
PENPOT_SMTP_TLS=false
PENPOT_SMTP_SSL=false
PENPOT_SMTP_DEFAULT_FROM=penpot@penpotter.local
PENPOT_SMTP_DEFAULT_REPLY_TO=penpot@penpotter.local

# When you want mail that actually reaches inboxes, keep everything else and
# swap these for a free-tier relay (Brevo/Resend/SMTP2GO all have $0 tiers),
# then remove `mailpit` from COMPOSE_PROFILES:
#   PENPOT_SMTP_HOST=smtp-relay.example.com
#   PENPOT_SMTP_PORT=587
#   PENPOT_SMTP_USERNAME=...
#   PENPOT_SMTP_PASSWORD=...
#   PENPOT_SMTP_TLS=true

# --- misc --------------------------------------------------------------------
PENPOT_TELEMETRY_ENABLED=false
PENPOT_MAX_BODY_SIZE=367001600
VALKEY_MAXMEMORY=128mb

# --- resource limits (defaults sized for a ~6GB host) ------------------------
# Penpot's own recommendation is 4 CPU / 16GB. Below that, cap the JVM and
# Postgres explicitly or they will fight each other and the OOM killer wins.
BACKEND_JVM_OPTS=-Xmx1g
BACKEND_MEM_LIMIT=1600m
EXPORTER_MEM_LIMIT=1g
PG_SHARED_BUFFERS=384MB
PG_EFFECTIVE_CACHE_SIZE=1GB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=96MB
PG_MAX_CONNECTIONS=50
# MUST stay well under PG_MAX_CONNECTIONS: Penpot opens the whole pool eagerly.
PENPOT_DB_POOL_SIZE=20
