# Penpotter production (home lab). Copy to .env on the server and fill in.
# NEVER commit the real .env — it is gitignored.

# --- images ------------------------------------------------------------------
# Until our own CI images exist, run upstream stable. Our `penpotter` branch is
# based on upstream main (the 2.17 line), so switching the prefix later is an
# ordinary forward upgrade on the same database.
IMAGE_PREFIX=penpotapp/
PENPOT_VERSION=2.17
# Ours, once CI is green. Pin to an immutable vX.Y.Z tag rather than `release`
# so a rollback is a one-line edit.
# IMAGE_PREFIX=ghcr.io/amannigam/penpotter-
# PENPOT_VERSION=release

# --- exposure ----------------------------------------------------------------
# The URL users type. MUST match how they reach it, or assets/websockets break.
# On the home lab this is served by `tailscale serve` on port 8443, because
# port 443 on lab.tail101716.ts.net is already proxying another service.
PENPOT_PUBLIC_URI=https://lab.tail101716.ts.net:8443
PENPOT_HTTP_PORT=9001
# 127.0.0.1 = reverse proxy / tailscale serve only. 0.0.0.0 = reachable on LAN.
PENPOT_BIND=127.0.0.1
# Only used with the `caddy` profile.
PENPOT_DOMAIN=design.example.com

# --- feature flags -----------------------------------------------------------
# Internal instance: registration closed (invite-only), email verification on,
# real SMTP, secure cookies ON (do NOT add disable-secure-session-cookies when
# serving over HTTPS), telemetry off.
PENPOT_FLAGS=disable-registration enable-smtp enable-mcp enable-webhooks enable-access-tokens enable-auto-file-snapshot disable-telemetry
# If you must serve over plain HTTP on the LAN, append: disable-secure-session-cookies
# (logins will not work over HTTP with secure cookies enabled.)

# --- secrets -----------------------------------------------------------------
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PENPOT_SECRET_KEY=
# openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_USER=penpot
POSTGRES_DB=penpot

# --- email -------------------------------------------------------------------
# Required for invitations and password resets. Without it, nobody can be invited.
PENPOT_SMTP_HOST=
PENPOT_SMTP_PORT=587
PENPOT_SMTP_USERNAME=
PENPOT_SMTP_PASSWORD=
PENPOT_SMTP_TLS=true
PENPOT_SMTP_SSL=false
PENPOT_SMTP_DEFAULT_FROM=penpot@example.com
PENPOT_SMTP_DEFAULT_REPLY_TO=penpot@example.com

# --- misc --------------------------------------------------------------------
PENPOT_TELEMETRY_ENABLED=false
PENPOT_MAX_BODY_SIZE=367001600
VALKEY_MAXMEMORY=128mb

# --- resource limits (defaults sized for a ~6GB host) ------------------------
# Penpot's own recommendation is 4 CPU / 16GB. Below that, cap the JVM and
# Postgres explicitly or they will fight each other and the OOM killer wins.
BACKEND_JVM_OPTS=-Xmx1g
BACKEND_MEM_LIMIT=1600m
EXPORTER_MEM_LIMIT=1g
PG_SHARED_BUFFERS=384MB
PG_EFFECTIVE_CACHE_SIZE=1GB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=96MB
PG_MAX_CONNECTIONS=50
